generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  password_hash  String?
  email_verified DateTime? @db.Timestamptz(6)
  // Login MFA -- defaults to 'disabled' for every existing and new user, so
  // this ships with zero behavior change until a user opts in themselves
  // (see Settings > Profile > Security). 'sms'/'whatsapp' send a 6-digit
  // code each login; 'totp' verifies against an authenticator app (Google
  // Authenticator etc.) with no server-sent code at all.
  mfa_method     String    @default("disabled") // 'disabled' | 'sms' | 'whatsapp' | 'totp'
  mfa_phone      String?   // E.164 -- delivery number for sms/whatsapp OTP
  /// AES-256-GCM encrypted base32 TOTP secret -- only set when mfa_method = 'totp'.
  totp_secret    String?
  mfa_enabled_at DateTime? @db.Timestamptz(6)
  /// Set by "Sign out everywhere" (Settings > Profile > Sessions) -- the
  /// bulk revocation mechanism: any token issued before this timestamp is
  /// rejected in auth.ts's jwt callback on its next use, regardless of
  /// which UserSession row it belongs to. Per-device revocation is
  /// UserSession.revoked_at below; this field is for revoking all of them
  /// at once without having to touch every row.
  session_invalidated_at DateTime? @db.Timestamptz(6)
  /// User-configurable inactivity auto-logout (Settings > Profile >
  /// Sessions > gear icon) — a device with no activity for this many
  /// minutes gets auto-revoked. See INACTIVITY_LIMIT_MS's replacement in
  /// auth.ts's jwt callback and GET /api/account/sessions' lazy sweep.
  /// Default 4320 = 3 days, matching the previous hardcoded constant.
  session_inactivity_limit_minutes Int @default(4320)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  profile                      Profile?
  mfa_challenges                MfaChallenge[]
  owned_accounts               Account[]                    @relation("AccountOwner")
  contacts                     Contact[]
  tags                         Tag[]
  custom_fields                CustomField[]
  contact_notes                ContactNote[]
  conversations                Conversation[]
  message_templates            MessageTemplate[]
  pipelines                    Pipeline[]
  deals                        Deal[]
  broadcasts                   Broadcast[]
  automations                  Automation[]
  automation_logs              AutomationLog[]
  automation_pending_executions AutomationPendingExecution[]
  flows                        Flow[]
  flow_runs                    FlowRun[]
  whatsapp_configs             WhatsAppConfig[]
  ai_configs                   AiConfig[]
  sms_configs                  SmsConfig[]
  email_configs                EmailConfig[]
  rcs_configs                  RcsConfig[]
  meta_ads_configs             MetaAdsConfig[]
  catalog_configs               CatalogConfig[]
  payment_gateway_configs        PaymentGatewayConfig[]
  invitations_created          AccountInvitation[]          @relation("InvitationCreator")
  invitations_accepted         AccountInvitation[]          @relation("InvitationAcceptor")
  leads                        Lead[]
  leads_assigned               Lead[]                       @relation("LeadAssignee")
  follow_ups                   FollowUp[]
  follow_ups_assigned          FollowUp[]                   @relation("FollowUpAssignee")
  lead_activities              LeadActivity[]
  segments                     Segment[]
  tasks                        Task[]
  tasks_assigned               Task[]                       @relation("TaskAssignee")
  conversations_assigned       Conversation[]               @relation("ConversationAgent")
  push_subscriptions           PushSubscription[]
  scheduled_messages           ScheduledMessage[]
  email_verification_tokens    EmailVerificationToken[]
  sessions                     UserSession[]
  contact_merges_performed     ContactMerge[]

  @@map("users")
}

/// One row per login -- real per-device session tracking (Settings >
/// Profile > Sessions). auth.ts's authorize() creates a row (capturing the
/// device/browser from the User-Agent header and, best-effort, the client
/// IP) and embeds its id in the JWT as token.sessionId; the jwt callback
/// checks revoked_at on every request, so setting it here actually forces
/// that one device to sign in again on its next request -- not just a UI
/// list. device_label is derived once at login time (e.g. "Windows -
/// Chrome"), not re-detected per request.
model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  device_label String
  user_agent   String?
  ip_address   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

// A one-time link token for confirming a user's own email address (Settings
// > Profile "Verify" button, and the not-verified-yet banner on Dashboard).
// Only token_hash (SHA-256 of the plaintext) is stored — same reasoning as
// AccountInvitation.token_hash: a leaked DB snapshot alone can't be used to
// confirm someone else's email, the raw token only ever appears once, in
// the emailed link itself.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

// A short-lived MFA code/session, for two purposes: 'login' (a challenge
// created mid-sign-in, consumed by auth.ts's authorize() once verified) and
// 'enroll' (confirming a new phone/authenticator app BEFORE actually
// turning MFA on, so a typo'd number or a missed QR scan can't lock the
// user out of their own account). code_hash is null for TOTP challenges --
// there's no server-generated code to check, the live 30-second window is
// verified directly against the user's stored secret instead.
model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  purpose    String    // 'login' | 'enroll'
  method     String    // 'sms' | 'whatsapp' | 'totp'
  /// bcrypt hash of the 6-digit code (sms/whatsapp only).
  code_hash  String?
  // 'enroll' only -- the phone number being verified, held here (not yet
  // written to User.mfa_phone) until the code is confirmed.
  pending_phone String?
  verified   Boolean   @default(false)
  consumed_at DateTime? @db.Timestamptz(6)
  attempts   Int       @default(0)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_challenges")
}

// ============================================================
// ACCOUNTS & TEAM
// ============================================================

enum AccountRole {
  owner
  supervisor
  admin
  agent
  viewer

  @@map("account_role")
}

model Account {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  owner_user_id    String   @db.Uuid
  default_currency String   @default("USD")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  owner       User                @relation("AccountOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  profiles    Profile[]
  invitations AccountInvitation[]

  contacts                     Contact[]
  tags                         Tag[]
  custom_fields                CustomField[]
  contact_notes                ContactNote[]
  conversations                Conversation[]
  whatsapp_configs              WhatsAppConfig[]
  ai_config                    AiConfig?
  sms_config                   SmsConfig?
  email_config                 EmailConfig?
  rcs_config                   RcsConfig?
  meta_ads_config              MetaAdsConfig?
  catalog_config                CatalogConfig?
  products                     Product[]
  orders                       Order[]
  payment_gateway_configs      PaymentGatewayConfig[]
  whatsapp_payments            WhatsAppPayment[]
  lead_ad_forms                LeadAdForm[]
  lead_ad_submissions          LeadAdSubmission[]
  contact_merges               ContactMerge[]
  meta_custom_audiences        MetaCustomAudience[]
  message_templates            MessageTemplate[]
  pipelines                    Pipeline[]
  deals                        Deal[]
  broadcasts                   Broadcast[]
  automations                  Automation[]
  automation_logs              AutomationLog[]
  automation_pending_executions AutomationPendingExecution[]
  flows                        Flow[]
  flow_runs                    FlowRun[]
  data_tables                  DataTable[]
  file_uploads                 FileUpload[]
  leads                        Lead[]
  follow_ups                   FollowUp[]
  lead_activities              LeadActivity[]
  segments                     Segment[]
  tasks                        Task[]
  push_subscriptions           PushSubscription[]
  capture_config               ContactCaptureConfig?
  lead_settings                LeadSettings?
  api_keys                     ApiKey[]
  webhooks                     Webhook[]
  integrations                 Integration[]
  scheduled_messages           ScheduledMessage[]

  @@unique([owner_user_id])
  @@map("accounts")
}

model AccountInvitation {
  id                  String      @id @default(uuid()) @db.Uuid
  account_id          String      @db.Uuid
  token_hash          String      @unique
  role                AccountRole
  created_by_user_id  String?     @db.Uuid
  label               String?
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  expires_at          DateTime    @db.Timestamptz(6)
  accepted_at         DateTime?   @db.Timestamptz(6)
  accepted_by_user_id String?     @db.Uuid

  account      Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  created_by   User?   @relation("InvitationCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  accepted_by  User?   @relation("InvitationAcceptor", fields: [accepted_by_user_id], references: [id], onDelete: SetNull)

  @@map("account_invitations")
}

model Profile {
  id           String      @id @default(uuid()) @db.Uuid
  user_id      String      @unique @db.Uuid
  full_name    String      @default("")
  email        String
  avatar_url   String?
  /// This person's own WhatsApp number (E.164, e.g. "+919876543210") —
  /// collected at signup as a country-code select + local-number input,
  /// combined into one string before saving. Distinct from
  /// WhatsAppConfig.phone_number_id, which is the Business Platform
  /// number the app sends/receives through, not a team member's own.
  phone        String?
  /// When phone was last confirmed via a WhatsApp/SMS OTP (Settings > Profile
  /// "Verify" button). Null = not verified. Cleared back to null whenever
  /// `phone` itself is changed, so an edited number can't inherit the old
  /// number's verified status.
  phone_verified_at DateTime? @db.Timestamptz(6)
  account_id   String      @db.Uuid
  account_role          AccountRole
  restrict_to_assigned  Boolean     @default(false)
  /// Personal chat-translation setting (Settings > Profile) — a free-text
  /// language name (e.g. "Malayalam", "English"), not a fixed enum, since
  /// Gemini's translation isn't limited to a short hardcoded list. Null =
  /// translation UI (the "Translate" link on inbound messages, the
  /// composer's translate button) doesn't render at all for this person —
  /// off by default, zero behavior change for existing users.
  preferred_language    String?
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @updatedAt @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================================
// CONTACTS
// ============================================================

model Contact {
  id               String   @id @default(uuid()) @db.Uuid
  account_id       String   @db.Uuid
  user_id          String   @db.Uuid
  phone            String
  phone_normalized String?
  alternate_phone  String?
  name             String?
  email            String?
  company          String?
  gender           String?
  avatar_url       String?
  external_id      String?                        // dedup key for external integrations (HMS, LMS, etc.)
  // Dedicated per-platform identity columns — never reuse `phone` for these.
  // Instagram/Facebook platform IDs are matched by exact equality only, never
  // via the fuzzy last-8-digit suffix matching used for real phone numbers
  // (findExistingContact in src/lib/contacts/dedupe.ts) — that heuristic only
  // makes sense for phone numbers and would risk cross-channel identity
  // collisions if reused here.
  instagram_id     String?                        // Instagram-scoped platform ID (IGSID)
  facebook_id      String?                        // Facebook Messenger-scoped platform ID (PSID)
  /// Tri-state: "unknown" (default — most creation paths have no explicit
  /// consent signal), "opted_in" (an inbound message on any channel, or an
  /// explicit action like a Lead Ads form submission, is itself consent),
  /// "opted_out" (reserved for a future inbound-STOP-keyword handler — not
  /// built yet, nothing sets this today).
  opt_in_status    String   @default("unknown")
  /// Which creation path captured this contact — see the tag list in
  /// findOrCreateContact-style call sites across the webhook/import routes.
  opt_in_source    String?
  opt_in_at        DateTime? @db.Timestamptz(6)
  opted_out_at     DateTime? @db.Timestamptz(6)
  // Set when this contact was absorbed by a "Merge contacts" action (IG·04)
  // — soft-deleted rather than hard-deleted so every existing FK pointing
  // at it (conversations, deals, leads, etc.) stays valid; UIs that list
  // live contacts filter WHERE merged_into_contact_id IS NULL.
  merged_into_contact_id String? @db.Uuid
  /// Language this contact's messages were last detected in (chat
  /// translation feature) — a free-text language name, e.g. "Arabic",
  /// "Tamil". Updated whenever an inbound message from them is
  /// translated; lets the composer's "Translate" button translate an
  /// outbound draft into their language without re-detecting it. Null
  /// until their first message is ever translated.
  detected_language String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  merged_into      Contact?  @relation("ContactMergedInto", fields: [merged_into_contact_id], references: [id], onDelete: SetNull)
  absorbed_contacts Contact[] @relation("ContactMergedInto")

  tags                         ContactTag[]
  custom_values                ContactCustomValue[]
  notes                        ContactNote[]
  conversations                Conversation[]
  deals                        Deal[]
  broadcast_recipients         BroadcastRecipient[]
  automation_logs              AutomationLog[]
  automation_pending_executions AutomationPendingExecution[]
  flow_runs                    FlowRun[]
  leads                        Lead[]
  follow_ups                   FollowUp[]
  lead_activities              LeadActivity[]
  tasks                        Task[]
  scheduled_messages           ScheduledMessage[]

  @@unique([account_id, phone_normalized], name: "contacts_account_phone_normalized")
  @@unique([account_id, instagram_id], name: "contacts_account_instagram_id")
  @@unique([account_id, facebook_id], name: "contacts_account_facebook_id")
  @@map("contacts")
}

// Audit trail for IG·04 "Merge contacts across channels" — who merged what
// into what, and when. There is no undo in v1 (merge is a deliberate,
// explicit, manually-confirmed action, never automatic — same caution this
// app already applies to opt-in status), so this row is what lets support/
// an admin manually reconstruct what happened if a merge turns out wrong.
model ContactMerge {
  id                      String   @id @default(uuid()) @db.Uuid
  account_id              String   @db.Uuid
  survivor_contact_id     String   @db.Uuid
  merged_contact_id       String   @db.Uuid
  /// Full pre-merge row of the absorbed contact — kept even though that
  /// row itself still exists (soft-deleted via merged_into_contact_id),
  /// as a durable point-in-time reference independent of any future
  /// changes to the absorbed row.
  merged_contact_snapshot Json
  performed_by_user_id    String   @db.Uuid
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  account         Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  performed_by    User    @relation(fields: [performed_by_user_id], references: [id], onDelete: Cascade)

  @@index([account_id, created_at])
  @@map("contact_merges")
}

model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  account_id String   @db.Uuid
  user_id    String   @db.Uuid
  name       String
  color      String   @default("#3b82f6")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  account  Account      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  id         String   @id @default(uuid()) @db.Uuid
  contact_id String   @db.Uuid
  tag_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, tag_id])
  @@map("contact_tags")
}

model CustomField {
  id            String   @id @default(uuid()) @db.Uuid
  account_id    String   @db.Uuid
  user_id       String   @db.Uuid
  field_name    String
  field_type    String   @default("text")
  field_options Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  account Account              @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  values  ContactCustomValue[]

  @@map("custom_fields")
}

model ContactCustomValue {
  id              String   @id @default(uuid()) @db.Uuid
  contact_id      String   @db.Uuid
  custom_field_id String   @db.Uuid
  value           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  contact      Contact     @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  custom_field CustomField @relation(fields: [custom_field_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, custom_field_id])
  @@map("contact_custom_values")
}

model ContactNote {
  id         String   @id @default(uuid()) @db.Uuid
  account_id String   @db.Uuid
  contact_id String   @db.Uuid
  user_id    String   @db.Uuid
  note_text  String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("contact_notes")
}

// ============================================================
// CONVERSATIONS & MESSAGES
// ============================================================

model Conversation {
  id                String    @id @default(uuid()) @db.Uuid
  account_id        String    @db.Uuid
  user_id           String    @db.Uuid
  contact_id        String    @db.Uuid
  status            String    @default("open")
  assigned_agent_id String?   @db.Uuid
  last_message_text String?
  last_message_at   DateTime? @db.Timestamptz(6)
  unread_count      Int       @default(0)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  account        Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user           User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact        Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  assigned_agent User?   @relation("ConversationAgent", fields: [assigned_agent_id], references: [id], onDelete: SetNull)

  messages         Message[]
  message_reactions MessageReaction[]
  deals            Deal[]
  flow_runs        FlowRun[]
  scheduled_messages ScheduledMessage[]

  // Channel that originated this conversation
  channel         String   @default("whatsapp") // 'whatsapp' | 'instagram' | 'facebook' | 'sms' | 'email' | 'rcs'

  // Which connected WhatsApp number this thread belongs to (Finding #14)
  // — null for non-WhatsApp channels and for rows that predate multi-
  // number support (migration 055 backfills every existing WhatsApp
  // conversation to the account's sole pre-existing number). A contact
  // messaging two different business numbers now gets two separate
  // conversations instead of collapsing into one.
  whatsapp_config_id String?         @db.Uuid
  whatsapp_config     WhatsAppConfig? @relation(fields: [whatsapp_config_id], references: [id], onDelete: SetNull)

  // Contact name capture flow state
  capture_state   String?  // null | 'awaiting_confirm' | 'awaiting_name'
  capture_wa_name String?  // WhatsApp profile name shown in the confirmation prompt

  // Click-to-WhatsApp ad attribution — captured once, from the referral
  // object on the customer's first message, never overwritten after.
  // Used to report real outcomes (qualified lead, closed deal) back to
  // Meta via the Conversions API for Business Messaging.
  ctwa_clid        String?
  ctwa_ad_headline String?
  ctwa_source_id   String?
  // Meta's separate 72-hour Free Entry Point window — distinct from the
  // general 24h customer-service session window above. Set when the first
  // outbound reply to a referral-attributed conversation lands within 24h
  // of the inbound message; while this is in the future, even TEMPLATE
  // messages (not just session messages) are billed free by Meta.
  fep_expires_at   DateTime? @db.Timestamptz(6)

  @@index([account_id, unread_count])
  @@index([account_id, last_message_at])
  // Was a plain, non-enforcing @@index — findOrCreateConversation
  // (webhook/route.ts) did an unguarded findFirst-then-create with no DB
  // backstop, so two near-simultaneous inbound deliveries for the same
  // contact/number could both pass the findFirst and both insert,
  // producing two permanent threads for one contact (found live, Sept
  // 2026: contact "jithulr44" showing as both an unassigned and an
  // agent-assigned conversation). Same bug class, same fix, as
  // WhatsAppConfig.phone_number_id (migration 063). See migration 066
  // for the one-time dedupe of any existing duplicates this backfills
  // before the constraint is added.
  //
  // Only closes the race for the WhatsApp channel — whatsapp_config_id
  // is non-null there (every inbound message names the number it
  // arrived on). Facebook/Instagram conversations always have a null
  // whatsapp_config_id, and a plain UNIQUE constraint treats every NULL
  // as distinct from every other NULL, so it gives those two channels no
  // DB-level protection. Closing that too would need a NULLS NOT
  // DISTINCT / expression index, which Prisma's schema DSL can't
  // declare — an un-declared raw index is a real risk of being silently
  // dropped by a future `prisma db push` (it syncs the DB to exactly
  // match this file). findOrCreateFbConversation/findOrCreateIgConversation
  // still get the same code-level retry-on-conflict fix for defense in
  // depth, just without this backstop.
  // Superseded by the @@unique below, which Postgres already backs with
  // an index covering these same columns in the same order — a second
  // plain index here would just be dead weight.
  @@unique([account_id, contact_id, channel, whatsapp_config_id])
  @@map("conversations")
}

model Message {
  id                  String   @id @default(uuid()) @db.Uuid
  conversation_id     String   @db.Uuid
  sender_type         String
  sender_id           String?  @db.Uuid
  content_type        String   @default("text")
  content_text        String?
  media_url           String?
  // Real MIME type from Meta's webhook payload (e.g. "application/pdf") —
  // was parsed and immediately discarded before (`void mediaType`, no
  // column to put it in). Needed to reliably detect a PDF vs. any other
  // document type rather than sniffing a filename string.
  media_mime_type     String?
  // The document's original filename, kept separate from content_text —
  // content_text prefers the customer's caption when one is given, which
  // would otherwise be the ONLY thing stored, losing the real filename.
  media_filename      String?
  // AI-generated transcript of an inbound WhatsApp voice note (audio
  // messages only) — populated asynchronously after the message is
  // created, by src/lib/whatsapp/audio-transcription.ts. Mirrored into
  // content_text once ready so reply-quote previews and the conversation
  // list show real content instead of "[Audio]", but a completed
  // transcript deliberately does NOT re-trigger automations/flow dispatch
  // for that message — see the migration/plan for why.
  transcript          String?
  // Structured snapshot of an inbound WhatsApp order message — populated
  // post-hoc by src/lib/whatsapp/order-processing.ts once the matching
  // Order row is created, same "dedicated column mirrored in after the
  // fact" shape as `transcript` above. Read directly by the inbox bubble,
  // no extra fetch/join: { items: [{retailer_id, quantity, item_price,
  // name}], subtotal, currency, deal_id }.
  order_snapshot      Json?
  // Instagram story_reply/story_mention only — the replied-to (or
  // mentioned) story's own media, so the inbox bubble can render a
  // reply-context card above the message instead of just plain text.
  story_media_url     String?
  story_media_id      String?
  template_name       String?
  message_id          String?
  status              String   @default("sent")
  interactive_reply_id String?
  reply_to_message_id String?   @db.Uuid
  email_subject       String?   // Email channel only — subject/body split the other channels don't have
  // Set only for a message a Broadcast campaign sent — previously broadcasts
  // never wrote a Message row at all (only broadcast_recipients), so a sent
  // campaign was completely invisible in that contact's Inbox thread. This
  // both makes the message show up AND lets the bubble render a "Broadcast"
  // tag instead of looking like an indistinguishable one-off agent send.
  broadcast_id        String?   @db.Uuid
  // Chat translation (agent-facing "Translate" link on inbound text
  // messages) — same "populated after the fact, mirrored onto a
  // dedicated column" shape as `transcript` above. Cached per-message so
  // re-opening a conversation doesn't re-call Gemini for something
  // already translated once; detected_lang/translated_lang together let
  // a stale cache (e.g. the agent's preferred_language changed) be
  // detected and re-translated rather than shown wrong.
  detected_lang       String?
  translated_text     String?
  translated_lang     String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  reply_to        Message?     @relation("MessageReplies", fields: [reply_to_message_id], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  reactions       MessageReaction[]
  prompt_for_runs FlowRun[]    @relation("LastPromptMessage")
  broadcast       Broadcast?   @relation(fields: [broadcast_id], references: [id], onDelete: SetNull)

  @@map("messages")
}

// A message (text/media/buttons) queued to send to one conversation at a
// future time, either once or on a repeating interval. Distinct from
// Broadcast (which fans one message out to many contacts once) and
// Automation (event-triggered) -- this is a time/interval-triggered send
// scoped to a single ongoing conversation, e.g. "remind this customer every
// 2 days until they reply, up to 5 times."
model ScheduledMessage {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @db.Uuid
  conversation_id String    @db.Uuid
  contact_id      String    @db.Uuid
  created_by      String    @db.Uuid

  // Scheduled messages must be Meta-approved templates -- WhatsApp rejects
  // free-form text/media outside the 24h customer-service window, which a
  // scheduled (especially recurring, multi-day) send routinely lands
  // outside of. template_name/template_language identify the approved
  // template; the rest fill its variables. content_text holds a rendered
  // preview only, for the list UI -- it is never sent as-is.
  content_text          String?
  template_name         String?
  template_language     String?
  template_body_params  Json? // string[] -- body variable values, in order
  template_header_text  String? // header variable value, if the template's header has one
  template_button_params Json? // Record<number, string> -- per-URL-button variable suffixes
  // media_url/media_type serve two purposes that never overlap on the same
  // row: (1) a media-header override for a media-type template, picked at
  // schedule time (see the sweep, which passes this as headerMediaUrl), and
  // (2) the legacy free-form media field on rows created before templates
  // became mandatory.
  media_url    String?
  media_type   String? // 'image' | 'video' | 'document' | 'audio'
  buttons      Json?   // InteractiveButton[] ({id, title}), 1-3 entries -- legacy only

  schedule_type  String @default("once") // 'once' | 'recurring'
  interval_value Int? // recurring only
  interval_unit  String? // 'minutes' | 'hours' | 'days'
  stop_on_reply  Boolean @default(true) // recurring only -- stop once the customer sends a message after last_sent_at
  max_sends      Int     @default(1)
  sends_count    Int     @default(0)

  status       String    @default("active") // 'active' | 'paused' | 'completed' | 'cancelled' | 'failed' | 'expired'
  next_send_at DateTime  @db.Timestamptz(6)
  last_sent_at DateTime? @db.Timestamptz(6)
  error_message String? // set when status = 'failed' -- the last send error, shown in the list UI
  error_count   Int     @default(0) // consecutive failures; status flips to 'failed' after 3

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  account      Account      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([status, next_send_at])
  @@map("scheduled_messages")
}

model MessageReaction {
  id              String   @id @default(uuid()) @db.Uuid
  message_id      String   @db.Uuid
  conversation_id String   @db.Uuid
  actor_type      String
  actor_id        String?  @db.Uuid
  emoji           String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  message      Message      @relation(fields: [message_id], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@unique([message_id, actor_type, actor_id])
  @@map("message_reactions")
}

// ============================================================
// WHATSAPP CONFIG
// ============================================================

// Multiple rows per account as of migration 055 (Finding #14) — a tenant
// can connect several real WhatsApp numbers (e.g. "Sales", "Support").
// account_id is intentionally NOT @unique any more; is_default marks the
// one fallback row used wherever a specific number isn't otherwise known
// (an admin test message, a pre-migration conversation, etc.). The
// existing app-level rule "one phone_number_id belongs to exactly one
// account" (src/app/api/whatsapp/config/route.ts) still holds — this is
// several rows per account, never a shared number.
model WhatsAppConfig {
  id                     String    @id @default(uuid()) @db.Uuid
  account_id             String    @db.Uuid
  user_id                String    @db.Uuid
  phone_number_id        String
  waba_id                String?
  access_token           String
  verify_token           String?
  status                 String    @default("disconnected")
  registered_at          DateTime? @db.Timestamptz(6)
  subscribed_apps_at     DateTime? @db.Timestamptz(6)
  last_registration_error String?
  connected_at           DateTime? @db.Timestamptz(6)
  /// Debounces re-notifying on webhook redelivery of the same account/
  /// phone-number alert (quality change, account alert, review decision,
  /// security event) — see src/lib/whatsapp/account-webhook.ts.
  last_alert_notified_at DateTime? @db.Timestamptz(6)
  /// How this connection was set up — "quick" (Meta Embedded Signup popup)
  /// or "manual" (credentials pasted into the API Credentials form).
  connect_method         String    @default("manual")
  /// AES-256-GCM encrypted RSA private key for Meta Flows decryption.
  /// When set, takes priority over FLOWS_PRIVATE_KEY env var — no server restart needed.
  flows_private_key      String?
  /// Display label for this number ("Sales Line") — shown wherever a
  /// tenant with multiple numbers has to pick one.
  label                  String?
  /// Exactly one true per account — the fallback number used wherever a
  /// specific one isn't otherwise resolvable. The first number an
  /// account ever connects becomes the default automatically.
  is_default             Boolean   @default(false)
  /// Raw value of Meta's marketing_messages_onboarding_status WABA field
  /// (Finding #10) — refreshed on demand, not polled. Only "ELIGIBLE"
  /// (Meta's own literal) unlocks routing marketing sends through
  /// /marketing_messages; every other value/null falls back to the
  /// normal endpoint transparently.
  marketing_messages_status String?
  /// Off by default (Finding #08b). Meta's Direct Send beta requires
  /// partner-manager approval per WABA that no API call can grant —
  /// this toggle only matters once that approval already exists; it
  /// never calls Meta itself.
  direct_send_enabled    Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  account         Account              @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  payment_gateway_config PaymentGatewayConfig?

  // DB-level enforcement of the app-level "one phone_number_id, one
  // account" rule checked in POST /api/whatsapp/config — that check is a
  // read-then-write with no lock, so two concurrent POSTs for the same
  // phone_number_id under different accounts could both pass it and
  // create duplicate rows. A duplicate silently breaks inbound delivery
  // forever after: the webhook's findMany-by-phone_number_id lookup sees
  // >1 row and drops every message for that number (see webhook/route.ts).
  // This constraint closes the race by rejecting the second insert
  // outright (Prisma P2002), which the route surfaces as the same 409
  // "already linked to another account" the app-level check gives today.
  @@unique([phone_number_id])
  @@index([account_id])
  @@map("whatsapp_config")
}

// A SINGLE platform-wide Meta App's credentials for Embedded Signup — NOT
// per-tenant like WhatsAppConfig above. One "Tech Provider" Meta App is what
// lets every tenant self-onboard their own WhatsApp number through the
// Embedded Signup popup; this table just holds that one app's own
// App ID / App Secret / Facebook-Login-for-Business Configuration ID, so the
// platform operator (not individual tenants) sets it once from a settings
// screen. Enforced as a singleton via a fixed id — always read/written at
// id "singleton", never a second row.
model MetaPlatformConfig {
  id         String   @id @default("singleton")
  app_id     String
  /// AES-256-GCM encrypted, same cipher as WhatsAppConfig.access_token.
  app_secret String
  config_id  String
  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("meta_platform_config")
}

// ============================================================
// META ADS — per-tenant, mirrors WhatsAppConfig's own shape
// ============================================================

// Connection to Meta's advertising side (Conversions API + Lead Ads),
// separate from WhatsAppConfig since the access token/scopes differ
// (ads_management/leads_retrieval vs. WhatsApp messaging permissions) —
// a tenant could in principle connect one without the other.
model MetaAdsConfig {
  id                       String    @id @default(uuid()) @db.Uuid
  account_id               String    @unique @db.Uuid
  user_id                  String    @db.Uuid
  waba_id                  String // WhatsApp Business Account ID — the dataset is created against this
  ad_account_id            String?
  business_id              String?
  /// AES-256-GCM encrypted, same cipher as WhatsAppConfig.access_token.
  access_token             String
  /// Conversions API dataset — created automatically on first successful test, not user-entered.
  dataset_id               String?
  automatic_events_enabled Boolean   @default(true)
  /// Standard Meta Pixel ID for a client's own website — separate from
  /// dataset_id (that one's for WhatsApp messaging events specifically).
  pixel_id                 String?
  /// Plain-text secret embedded in the public tracking snippet's URL —
  /// same convention as SmsConfig.webhook_secret. Not a login credential;
  /// authorizes only the narrow "send one web conversion event" action.
  web_events_secret        String?   @unique
  status                   String    @default("disconnected")
  last_tested_at           DateTime? @db.Timestamptz(6)
  test_error               String?
  connected_at             DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("meta_ads_config")
}

// ============================================================
// WHATSAPP CATALOGS — products, carts, orders (Finding #07)
// ============================================================

// One row per account — the connected Meta Commerce catalog this
// account's WhatsApp number sends products from. Mirrors MetaAdsConfig's
// shape exactly, including its own encrypted token (catalog read/write
// needs a token with catalog_management permission — usually the same
// Embedded Signup business token MetaAdsConfig's discovery already uses,
// but stored separately so a Manual Connect can supply a different one).
model CatalogConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @unique @db.Uuid
  user_id            String    @db.Uuid
  catalog_id         String
  business_id        String?
  /// AES-256-GCM encrypted, same cipher/helper as MetaAdsConfig.access_token.
  access_token       String
  // Optional — no default pipeline/stage means an inbound order still
  // creates an Order row, just not an auto-created Deal. Nothing else in
  // this codebase auto-creates a Deal today, so this is opt-in by design.
  default_pipeline_id String?  @db.Uuid
  default_stage_id    String?  @db.Uuid
  status             String    @default("disconnected")
  connected_at       DateTime? @db.Timestamptz(6)
  last_synced_at     DateTime? @db.Timestamptz(6)
  last_tested_at     DateTime? @db.Timestamptz(6)
  test_error         String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("catalog_config")
}

// A product authored in this CRM and pushed to Meta's catalog via the
// Catalog Batch API — this app is the source of truth, not a read-only
// mirror of Commerce Manager (though "Sync products" can pull in products
// added there directly too). Batch writes are asynchronous, so
// sync_status reflects that honestly instead of pretending an immediate
// confirmation exists.
model Product {
  id                String    @id @default(uuid()) @db.Uuid
  account_id        String    @db.Uuid
  catalog_id        String
  // SKU sent to Meta as retailer_id — auto-generated ("prod-{uuid}") if
  // the user doesn't set one, but always unique per account.
  retailer_id       String
  name              String
  description       String?
  price             Decimal?  @db.Decimal(12, 2)
  currency          String?
  image_url         String?
  availability      String    @default("in stock")
  category          String?
  brand             String?
  // pending (just saved, not yet confirmed against Meta) | synced | error
  sync_status       String    @default("pending")
  raw_meta_response Json?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([account_id, retailer_id])
  @@index([account_id, catalog_id])
  @@map("catalog_products")
}

// An order a customer placed from a WhatsApp cart, parsed from an inbound
// `order` message. contact_id/conversation_id/message_id/deal_id are
// deliberately unenforced soft references (this codebase's existing
// loose-coupling style for optional cross-links), not Prisma relations.
model Order {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @db.Uuid
  // Meta's wamid for the order message — the idempotency key, since a
  // webhook can redeliver the same event.
  wa_message_id   String    @unique
  message_id      String?   @db.Uuid
  contact_id      String?   @db.Uuid
  conversation_id String?   @db.Uuid
  catalog_id      String
  currency        String?
  // Snapshot at order time: [{retailer_id, quantity, item_price, name}].
  // item_price comes from the webhook itself (authoritative at order
  // time), not the Product's current price, which may have changed since.
  items           Json
  subtotal        Decimal?  @db.Decimal(12, 2)
  // Set when CatalogConfig.default_pipeline_id/default_stage_id were
  // configured at ingestion time and a Deal was auto-created.
  deal_id         String?   @db.Uuid
  status          String    @default("received") // received | converted | cancelled
  raw_payload     Json?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id, created_at])
  @@map("catalog_orders")
}

// ============================================================
// IN-CHAT UPI PAYMENTS (India) — Finding #09, gated scaffolding
// ============================================================
//
// Genuinely gated by TWO things no API call from this app can grant:
// (1) Meta's WaBiz payments enablement is a manual support-case review
//     per WABA, not a self-serve flag; (2) each tenant needs their own
//     UPI-enabled payment-gateway account (Razorpay/PayU/Billdesk/
//     Zaakpay — the only four Meta supports). This is real, working
//     scaffolding — connect a gateway, send order_details/order_status
//     messages, record payments — that activates the moment a tenant's
//     approval lands; it is NOT a "Connected ✓" claim the way Catalogs'
//     schema is, hence `status` defaulting to a state that says so.

// One row per connected WhatsApp number (payments are approved per-WABA
// on Meta's side, matching how CatalogConfig/MarketingMessages are
// account-wide but this is deliberately number-scoped).
model PaymentGatewayConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @db.Uuid
  whatsapp_config_id String    @unique @db.Uuid
  user_id            String    @db.Uuid
  gateway            String    // 'razorpay' | 'payu' | 'billdesk' | 'zaakpay' — the only 4 Meta supports
  /// AES-256-GCM encrypted key/secret pair, shape depends on `gateway`.
  credentials        Json
  // UPI Intent mode fields — VPA (Virtual Payment Address), Merchant
  // Category Code, Payee Code — obtained from the payment gateway.
  vpa                String?
  mcc                String?
  pc                 String?
  /// Never flips to "connected" the way Catalogs' status does — stays
  /// "pending_meta_approval" until the tenant confirms Meta has granted
  /// the WaBiz payments case, since nothing here can verify that itself.
  status             String    @default("pending_meta_approval")
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account         Account        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  whatsapp_config WhatsAppConfig @relation(fields: [whatsapp_config_id], references: [id], onDelete: Cascade)

  @@map("payment_gateway_config")
}

// A payment collected (or in progress) via an order_details/order_status
// message pair. contact_id/conversation_id are soft refs, matching this
// codebase's existing loose-coupling style for optional cross-links —
// same shape as the Catalogs Order model.
model WhatsAppPayment {
  id                      String    @id @default(uuid()) @db.Uuid
  account_id              String    @db.Uuid
  whatsapp_config_id      String    @db.Uuid
  conversation_id         String?   @db.Uuid
  contact_id              String?   @db.Uuid
  /// Meta's wamid for the order_details message — idempotency key, same
  /// pattern as the Catalogs Order model's wa_message_id.
  wa_order_message_id     String    @unique
  /// This app's own order/invoice reference, threaded through the UPI
  /// intent link, the order_status follow-up, and Razorpay's own
  /// `reference_id` field on the payment link — Razorpay echoes that
  /// field back on every webhook event for the link, which is how the
  /// webhook route identifies which WhatsAppPayment (and therefore which
  /// tenant's gateway credentials) a given webhook POST is about, since
  /// Razorpay's webhook URL is one shared endpoint across every tenant,
  /// not a per-payment or per-tenant URL. @unique so that lookup is safe.
  reference_id            String    @unique
  amount                  Decimal   @db.Decimal(12, 2)
  currency                String    @default("INR")
  status                  String    @default("pending") // pending | processing | completed | failed
  gateway_transaction_id  String?
  raw_payload             Json?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id, created_at])
  @@map("whatsapp_payments")
}

// One row per Meta Lead Ads / Instant Form the account has chosen to sync.
model LeadAdForm {
  id            String   @id @default(uuid()) @db.Uuid
  account_id    String   @db.Uuid
  meta_form_id  String   @unique
  page_id       String
  name          String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  account     Account            @relation(fields: [account_id], references: [id], onDelete: Cascade)
  submissions LeadAdSubmission[]

  @@index([account_id])
  @@map("lead_ad_forms")
}

// One row per Instant Form submission, fetched via the leadgen webhook +
// a follow-up Graph API call — retained independently of the 90-day
// window Meta itself enforces on lead data.
model LeadAdSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  account_id      String   @db.Uuid
  // Nullable — a small but real slice of Meta's leadgen webhook payloads
  // arrive with no form_id at all (and the follow-up lead-detail fetch
  // doesn't always carry one either). This row is still created in that
  // case (form_id: null) so the meta_leadgen_id uniqueness check below
  // still dedupes Meta's webhook retries; before this, a formless lead
  // never got a row at all, so every retry re-created a duplicate Contact/
  // Lead.
  form_id         String?  @db.Uuid
  meta_leadgen_id String   @unique
  ad_id           String?
  lead_id         String?  @db.Uuid // set once mapped into a real Lead row
  raw_field_data  Json // the exact field_data array Meta returned — never discarded, even after mapping
  // 'facebook' | 'instagram' | 'mixed' | null (unresolved). Resolved from
  // the ad set's targeting.publisher_platforms — the lead object itself
  // carries NO platform field (confirmed against Meta's Retrieving Leads
  // docs). 'mixed' means the ad set targets multiple platforms and Meta
  // gives no per-lead signal to split them — this is a real Meta API
  // ceiling, not a gap to "fix" by guessing a single platform.
  platform        String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  account Account     @relation(fields: [account_id], references: [id], onDelete: Cascade)
  form    LeadAdForm? @relation(fields: [form_id], references: [id], onDelete: Cascade)
  lead    Lead?      @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@index([account_id, created_at])
  @@map("lead_ad_submissions")
}

// One CRM Segment synced to Meta as a Custom Audience (hashed emails/
// phones for retargeting/lookalikes) — a Segment can map to at most one
// Meta audience, re-synced on demand rather than continuously.
model MetaCustomAudience {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @db.Uuid
  segment_id      String    @unique @db.Uuid
  meta_audience_id String
  synced_count    Int       @default(0)
  last_synced_at  DateTime? @db.Timestamptz(6)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@map("meta_custom_audiences")
}

// ============================================================
// AI CONFIG
// ============================================================

model AiConfig {
  id            String   @id @default(uuid()) @db.Uuid
  account_id    String   @unique @db.Uuid
  user_id       String   @db.Uuid
  /// Legacy single-provider fields — kept in place, unread by new code, as
  /// a rollback safety net for one release. Superseded by active_provider
  /// + provider_keys below. Do not read these in new code.
  provider      String   @default("gemini")
  api_key       String
  model         String   @default("gemini-1.5-flash")
  temperature   Float    @default(0.7)
  max_tokens    Int      @default(500)
  system_prompt String?
  /// Q&A pairs — { question, answer }[]. Re-scored for relevance against
  /// each incoming message at generation time (src/lib/ai/knowledge.ts),
  /// not dumped wholesale into every prompt.
  training_data Json?

  /// Which provider key in provider_keys is actually used to generate.
  active_provider   String  @default("gemini")
  /// Optional second provider, retried once if the active one fails with a
  /// retryable error (src/lib/ai/providers/registry.ts).
  fallback_provider String?
  /// Map of provider id -> { api_key (individually encrypted), model,
  /// base_url? }. base_url is used by "custom" (any OpenAI-compatible
  /// endpoint) and can override "deepseek"'s default. Never a plaintext
  /// key anywhere in this JSON.
  provider_keys     Json    @default("{}")

  /// Free-text reference documents -- { id, title, content, created_at }[],
  /// the richer half of "training" alongside training_data above.
  knowledge_documents  Json    @default("[]")
  /// Guardrail line the model is instructed to use instead of guessing
  /// when nothing relevant is found in the knowledge base.
  fallback_answer      String?
  /// Topics/phrases that should trigger "hand this to a human" guidance.
  escalation_topics    Json    @default("[]")
  /// Account-level default for how many past messages to include as
  /// conversation history; a flow node's own history_depth overrides this.
  history_depth_default Int    @default(6)
  /// Minimum retrieval confidence (0-1, cosine similarity when semantic
  /// search is active, or a normalized keyword-overlap score otherwise)
  /// for ai_reply to answer on its own. Below this, the node hands off
  /// to a human instead of guessing — see engine.ts's ai_reply handler.
  /// Only takes effect when low_confidence_handoff_enabled is true.
  confidence_threshold  Float   @default(0.35)
  /// Off by default — this is a real behavior change (a code-enforced
  /// handoff, not just prompt guidance like escalation_topics above),
  /// so existing accounts see zero difference until the owner turns it
  /// on in Settings > AI Config.
  low_confidence_handoff_enabled Boolean @default(false)
  /// Optional default agent to assign a low-confidence handoff to;
  /// unset means the conversation flips to "pending" with no specific
  /// assignee, same as the handoff node's own behavior with no assign_to.
  low_confidence_assign_to       String? @db.Uuid
  /// Holding message sent to the customer right before handing off.
  /// Falls back to a built-in default string when unset.
  low_confidence_message         String?

  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  knowledge_embeddings AiKnowledgeEmbedding[]

  @@map("ai_configs")
}

/// Caches a Gemini embedding vector for one piece of knowledge (a Q&A
/// pair or a document chunk), keyed by a content hash so an edit to the
/// source text invalidates and regenerates it automatically — no
/// explicit cache-busting needed elsewhere. Deliberately additive:
/// AiConfig.training_data/knowledge_documents (JSON) stay the source of
/// truth; this table is purely a derived index over them, built by
/// syncKnowledgeEmbeddings() when the account saves its knowledge base
/// (src/lib/ai/embeddings.ts). Dropping this table entirely is a safe,
/// full rollback — src/lib/ai/knowledge.ts falls back to its original
/// keyword-overlap scorer whenever no embedding rows exist for an
/// account, so semantic search is additive, never a hard dependency.
///
/// No ANN index (ivfflat/hnsw) on `embedding` — every real query already
/// filters to one ai_config_id first (a WHERE clause, not a table scan),
/// which keeps row counts in the tens-to-low-hundreds even for a large
/// knowledge base; brute-force cosine distance over that few rows is
/// fast without an index. Revisit only if an account's knowledge base
/// genuinely grows into the thousands of entries.
model AiKnowledgeEmbedding {
  id              String   @id @default(uuid()) @db.Uuid
  ai_config_id    String   @db.Uuid
  /// SHA-256 hex of the exact text that was embedded.
  content_hash    String
  /// 'qa' | 'chunk' — which half of the knowledge base this came from.
  kind            String
  /// Model that produced this vector, e.g. "gemini-embedding-001" —
  /// vectors from different models aren't comparable, so a future model
  /// change means old rows are orphaned (mismatched embedding_model,
  /// never matched by a query) and regenerated, not silently compared
  /// cross-model.
  embedding_model String
  /// pgvector column — Prisma has no native vector type, so this is
  /// Unsupported() and every read/write of the vector itself goes
  /// through raw SQL (embeddings.ts, knowledge.ts). gemini-embedding-001's
  /// documented default output size.
  embedding       Unsupported("vector(3072)")
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  ai_config AiConfig @relation(fields: [ai_config_id], references: [id], onDelete: Cascade)

  @@unique([ai_config_id, content_hash, embedding_model])
  @@map("ai_knowledge_embeddings")
}

// ============================================================
// SMS / EMAIL / RCS CONFIG
// ============================================================
// Three separate models rather than one shared discriminated table — each
// vendor's field shape is genuinely different (MSG91: sender ID + DLT ids;
// SendGrid: verified sender + inbound-parse host; Twilio: account SID +
// messaging service). Follows the WhatsAppConfig/AiConfig pattern (real
// Prisma columns, one row per account, secrets encrypted) rather than the
// Integration model's unencrypted-JSON shape, which is built for the
// separate REST/FHIR data-pull connectors, not messaging credentials.

model SmsConfig {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @unique @db.Uuid
  user_id         String    @db.Uuid
  provider        String    @default("msg91") // 'msg91' | 'textbee'
  /// AES-256-GCM encrypted secret — MSG91's Auth Key, or TextBee's API key,
  /// depending on `provider`. Same encrypted slot, different meaning.
  auth_key        String
  sender_id       String?   // 6-char DLT-approved sender ID (msg91 only)
  route           String?   @default("4") // MSG91 transactional route (msg91 only)
  dlt_entity_id   String?   // India DLT compliance (msg91 only)
  dlt_template_id String?   // per-account default; may need to move to a
                            // per-MessageTemplate column — see Stage 3 open
                            // questions in the implementation plan (msg91 only)
  device_id       String?   // TextBee device to send from; blank = TextBee's
                            // own default/most-recently-active device (textbee only)
  // TextBee's webhook subscription id, so re-saving PATCHes the existing
  // subscription (auto-registered via their API) instead of creating a
  // duplicate one on every save (textbee only).
  textbee_webhook_id String?
  webhook_secret  String?   // shared secret for inbound webhook auth — also
                            // doubles as the HMAC signing secret we register
                            // with TextBee's webhook API (see sms.ts)
  status          String    @default("disconnected")
  last_tested_at  DateTime? @db.Timestamptz(6)
  test_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sms_config")
}

model EmailConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @unique @db.Uuid
  user_id            String    @db.Uuid
  provider           String    @default("sendgrid")
  /// AES-256-GCM encrypted SendGrid API key.
  api_key            String
  from_email         String    // must be a SendGrid-verified sender
  from_name          String?
  inbound_parse_host String?   // MX subdomain configured for Inbound Parse
  inbound_secret     String?   // per-account token embedded in the inbound
                                // webhook URL path — Inbound Parse has no
                                // signature header, this is the substitute
  webhook_public_key String?   // SendGrid Ed25519 key, for the separate
                                // Event Webhook (delivery/open/click) — stretch,
                                // not required for MVP inbound messaging
  status             String    @default("disconnected")
  last_tested_at     DateTime? @db.Timestamptz(6)
  test_error         String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_config")
}

model RcsConfig {
  id                     String    @id @default(uuid()) @db.Uuid
  account_id             String    @unique @db.Uuid
  user_id                String    @db.Uuid
  provider               String    @default("twilio")
  account_sid            String    // Twilio Account SID (not secret, kept alongside)
  /// AES-256-GCM encrypted Twilio Auth Token.
  auth_token             String
  messaging_service_sid  String?   // recommended over a raw From number
  rcs_agent_id           String?   // once the RCS agent is approved by Google/Twilio
  from_number            String?   // fallback SMS/RCS sender if not using a messaging service
  status                 String    @default("disconnected")
  last_tested_at         DateTime? @db.Timestamptz(6)
  test_error             String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("rcs_config")
}

// ============================================================
// MESSAGE TEMPLATES
// ============================================================

model MessageTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  account_id        String    @db.Uuid
  user_id           String    @db.Uuid
  // Which WABA this template belongs to (Finding #14) — templates are
  // approved per-WABA on Meta's side, so a tenant with numbers on two
  // different WABAs needs the same template name to exist as two
  // distinct rows, not collide. Nullable for pre-migration rows
