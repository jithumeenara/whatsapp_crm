  created_at           DateTime @default(now()) @db.Timestamptz(6)

  table          DataTable  @relation("TableFields", fields: [table_id], references: [id], onDelete: Cascade)
  relation_table DataTable? @relation("FieldRelation", fields: [relation_table_id], references: [id], onDelete: SetNull)

  @@unique([table_id, field_key])
  @@map("data_fields")
}

model DataRecord {
  id         String   @id @default(uuid()) @db.Uuid
  table_id   String   @db.Uuid
  account_id String   @db.Uuid
  data       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  table DataTable @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@map("data_records")
}

// ============================================================
// FILE UPLOADS
// ============================================================

model FileUpload {
  id            String   @id @default(uuid()) @db.Uuid
  account_id    String   @db.Uuid
  original_name String
  stored_name   String
  file_path     String
  url           String
  mime_type     String
  size          Int
  file_category String   @default("other")
  scan_status   String   @default("pending")
  scan_result   Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("file_uploads")
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  account_id       String    @db.Uuid
  user_id          String    @db.Uuid
  contact_id       String?   @db.Uuid
  title            String
  source           String    @default("manual")  // whatsapp, instagram, website, campaign, referral, manual
  status           String    @default("new")     // new, call_not_connected, visited, appointment_fixed, follow_up, closed
  score            String    @default("warm")    // hot, warm, cold
  lead_quality     String?                       // qualified, not_qualified, wrong_enquiry
  call_outcome     String?                       // out_of_coverage, busy, switched_off, invalid_number
  closing_remarks  String?
  district         String?
  place            String?
  notes            String?
  assigned_to      String?   @db.Uuid
  claimed_at       DateTime? @db.Timestamptz(6)
  lost_reason      String?
  converted_at     DateTime? @db.Timestamptz(6)
  external_id      String?                        // dedup key for external integrations (HMS, LMS, etc.)
  is_hidden        Boolean   @default(false)       // hidden from agent view (set via raw SQL in PATCH)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  account    Account      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact    Contact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  assignee   User?        @relation("LeadAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  follow_ups FollowUp[]
  tasks      Task[]
  deals      Deal[]
  lead_ad_submissions LeadAdSubmission[]

  @@map("leads")
}

// ============================================================
// LEAD SETTINGS
// ============================================================

model LeadSettings {
  id                        String  @id @default(uuid()) @db.Uuid
  account_id                String  @unique @db.Uuid
  auto_lead_creation        Boolean @default(false)
  scoring_mode              String  @default("score")  // score | quality | both
  score_options             Json?   // string[] — custom score level labels (replaces hardcoded Hot/Warm/Cold)
  call_not_connected_labels Json?   // string[] — custom labels for not-connected outcomes
  call_connected_labels     Json?   // string[] — custom labels for connected outcomes
  close_enquiry_reasons     Json?   // string[] — reasons shown in close lead dropdown
  lead_sources              Json?   // {icon,label}[] — customisable lead source list
  webhook_secret            String? // plain-text secret for /api/external/webhook?secret=

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("lead_settings")
}

// ============================================================
// FOLLOW-UPS
// ============================================================

model FollowUp {
  id           String    @id @default(uuid()) @db.Uuid
  account_id   String    @db.Uuid
  user_id      String    @db.Uuid
  contact_id   String?   @db.Uuid
  lead_id      String?   @db.Uuid
  title        String
  note         String?
  due_at       DateTime  @db.Timestamptz(6)
  status       String    @default("pending") // pending, done, skipped
  assigned_to  String?   @db.Uuid
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  account  Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  lead     Lead?    @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  assignee User?    @relation("FollowUpAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@map("follow_ups")
}

// ============================================================
// LEAD ACTIVITIES (Timeline)
// ============================================================

model LeadActivity {
  id          String   @id @default(uuid()) @db.Uuid
  account_id  String   @db.Uuid
  contact_id  String?  @db.Uuid
  lead_id     String?  @db.Uuid
  user_id     String?  @db.Uuid
  type        String   // note, call, email, whatsapp, stage_change, follow_up, flow_submitted, created
  title       String
  description String?
  metadata    Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  account Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("lead_activities")
}

// ============================================================
// SEGMENTS
// ============================================================

model Segment {
  id            String   @id @default(uuid()) @db.Uuid
  account_id    String   @db.Uuid
  user_id       String   @db.Uuid
  name          String
  description   String?
  color         String   @default("#3b82f6")
  filter_config Json     @default("{}")
  // filter_config: { match: "all"|"any", rules: [{ field, op, value }] }
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meta_custom_audience MetaCustomAudience?

  @@map("segments")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  account_id   String    @db.Uuid
  user_id      String    @db.Uuid
  contact_id   String?   @db.Uuid
  lead_id      String?   @db.Uuid
  title        String
  description  String?
  priority     String    @default("medium") // low, medium, high, urgent
  status       String    @default("todo")   // todo, in_progress, done, cancelled
  due_date     DateTime? @db.Date
  assigned_to  String?   @db.Uuid
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  account  Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  lead     Lead?    @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// ============================================================
// PUSH NOTIFICATIONS
// ============================================================

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  account_id String   @db.Uuid
  endpoint   String
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([user_id, endpoint])
  @@map("push_subscriptions")
}

// ============================================================
// CONTACT CAPTURE CONFIG
// ============================================================

model ContactCaptureConfig {
  id               String   @id @default(uuid()) @db.Uuid
  account_id       String   @unique @db.Uuid
  enabled          Boolean  @default(false)
  confirm_message  String   @default("Hi {{name}}! Is that your real name? Please reply *Yes* to confirm or *No* to enter a different name.")
  ask_name_message String   @default("No problem! Please type your correct full name and I'll save it for you.")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("contact_capture_configs")
}

// ============================================================
// API KEYS  (external app access to Data Store)
// ============================================================

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  account_id   String    @db.Uuid
  name         String
  /// SHA-256 hex of the raw key — never store the raw key
  key_hash     String    @unique
  /// First 12 chars of the raw key shown in the UI for identification
  key_prefix   String
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ============================================================
// WEBHOOKS  (outbound delivery on Data Store changes)
// ============================================================

model Webhook {
  id                   String    @id @default(uuid()) @db.Uuid
  account_id           String    @db.Uuid
  name                 String
  url                  String
  /// 32-byte hex secret used to sign each delivery (HMAC-SHA256)
  signing_secret       String
  /// Array of event names: "record.created" | "record.updated" | "record.deleted"
  events               String[]
  /// Null = all tables; set to scope to one table
  table_id             String?   @db.Uuid
  is_active            Boolean   @default(true)
  last_triggered_at    DateTime? @db.Timestamptz(6)
  last_response_status Int?
  /// Consecutive delivery failures; auto-disabled at 10
  failure_count        Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @updatedAt @db.Timestamptz(6)

  account Account    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  table   DataTable? @relation(fields: [table_id], references: [id], onDelete: SetNull)

  @@map("webhooks")
}

// ============================================================
// EXTERNAL API INTEGRATIONS
// ============================================================

model Integration {
  id                    String    @id @default(uuid()) @db.Uuid
  account_id            String    @db.Uuid
  name                  String
  category              String    @default("custom")  // "ecommerce"|"payment"|"crm"|"feedback"|"healthcare"|"inventory"|"custom"
  source_type           String    @default("rest")    // "fhir" | "rest"
  base_url              String
  resource              String                         // e.g. "Patient" or "/api/orders"
  auth_type             String    @default("none")    // "none" | "api_key" | "bearer" | "basic"
  auth_config           Json?                          // { header, value } | { token } | { username, password }
  table_name            String?                        // override auto-generated table name
  sync_interval_minutes Int?                           // null=manual, 5/15/30/60/360/1440=auto
  status                String    @default("active")  // "active" | "paused" | "error"
  last_synced_at        DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  account Account           @relation(fields: [account_id], references: [id], onDelete: Cascade)
  syncs   IntegrationSync[]

  @@map("integrations")
}

model IntegrationSync {
  id             String    @id @default(uuid()) @db.Uuid
  integration_id String    @db.Uuid
  status         String                        // "running" | "success" | "error"
  records_synced Int       @default(0)
  contacts_created Int     @default(0)
  error_message  String?
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)

  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@map("integration_syncs")
}
