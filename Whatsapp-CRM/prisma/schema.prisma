  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

// ============================================================
// SMS / EMAIL / RCS CONFIG
// ============================================================
// Three separate models rather than one shared discriminated table — each
// vendor's field shape is genuinely different (MSG91: sender ID + DLT ids;
// SendGrid: verified sender + inbound-parse host; Twilio: account SID +
// messaging service). Follows the WhatsAppConfig/AiConfig pattern (real
// Prisma columns, one row per account, secrets encrypted) rather than the
// Integration model's unencrypted-JSON shape, which is built for the
// separate REST/FHIR data-pull connectors, not messaging credentials.

model SmsConfig {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @unique @db.Uuid
  user_id         String    @db.Uuid
  provider        String    @default("msg91") // 'msg91' | 'textbee'
  /// AES-256-GCM encrypted secret — MSG91's Auth Key, or TextBee's API key,
  /// depending on `provider`. Same encrypted slot, different meaning.
  auth_key        String
  sender_id       String?   // 6-char DLT-approved sender ID (msg91 only)
  route           String?   @default("4") // MSG91 transactional route (msg91 only)
  dlt_entity_id   String?   // India DLT compliance (msg91 only)
  dlt_template_id String?   // per-account default; may need to move to a
                            // per-MessageTemplate column — see Stage 3 open
                            // questions in the implementation plan (msg91 only)
  device_id       String?   // TextBee device to send from; blank = TextBee's
                            // own default/most-recently-active device (textbee only)
  // TextBee's webhook subscription id, so re-saving PATCHes the existing
  // subscription (auto-registered via their API) instead of creating a
  // duplicate one on every save (textbee only).
  textbee_webhook_id String?
  webhook_secret  String?   // shared secret for inbound webhook auth — also
                            // doubles as the HMAC signing secret we register
                            // with TextBee's webhook API (see sms.ts)
  status          String    @default("disconnected")
  last_tested_at  DateTime? @db.Timestamptz(6)
  test_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sms_config")
}

model EmailConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @unique @db.Uuid
  user_id            String    @db.Uuid
  provider           String    @default("sendgrid")
  /// AES-256-GCM encrypted SendGrid API key.
  api_key            String
  from_email         String    // must be a SendGrid-verified sender
  from_name          String?
  inbound_parse_host String?   // MX subdomain configured for Inbound Parse
  inbound_secret     String?   // per-account token embedded in the inbound
                                // webhook URL path — Inbound Parse has no
                                // signature header, this is the substitute
  webhook_public_key String?   // SendGrid Ed25519 key, for the separate
                                // Event Webhook (delivery/open/click) — stretch,
                                // not required for MVP inbound messaging
  status             String    @default("disconnected")
  last_tested_at     DateTime? @db.Timestamptz(6)
  test_error         String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_config")
}

model RcsConfig {
  id                     String    @id @default(uuid()) @db.Uuid
  account_id             String    @unique @db.Uuid
  user_id                String    @db.Uuid
  provider               String    @default("twilio")
  account_sid            String    // Twilio Account SID (not secret, kept alongside)
  /// AES-256-GCM encrypted Twilio Auth Token.
  auth_token             String
  messaging_service_sid  String?   // recommended over a raw From number
  rcs_agent_id           String?   // once the RCS agent is approved by Google/Twilio
  from_number            String?   // fallback SMS/RCS sender if not using a messaging service
  status                 String    @default("disconnected")
  last_tested_at         DateTime? @db.Timestamptz(6)
  test_error             String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("rcs_config")
}

