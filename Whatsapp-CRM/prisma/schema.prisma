  waba_id           String?
  name              String
  category          String    @default("Marketing")
  language          String?   @default("en_US")
  header_type       String?
  header_content    String?
  body_text         String
  footer_text       String?
  buttons           Json?
  status            String    @default("DRAFT")
  sample_values     Json?
  meta_template_id  String?
  rejection_reason  String?
  quality_score     String?
  header_handle     String?
  header_media_url  String?
  submission_error  String?
  last_submitted_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([account_id, waba_id, name, language])
  @@map("message_templates")
}

// ============================================================
// PIPELINES & DEALS
// ============================================================

model Pipeline {
  id         String   @id @default(uuid()) @db.Uuid
  account_id String   @db.Uuid
  user_id    String   @db.Uuid
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  account Account         @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  deals   Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  pipeline_id String   @db.Uuid
  name        String
  position    Int      @default(0)
  color       String   @default("#3b82f6")
  // 'open' | 'won' | 'lost' — every pipeline has exactly one 'won' and one
  // 'lost' stage (pinned, can be renamed but not deleted); everything else
  // is 'open'. Drives Deal.status when a deal moves into the stage.
  stage_type  String   @default("open")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  pipeline Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id                  String    @id @default(uuid()) @db.Uuid
  account_id          String    @db.Uuid
  user_id             String    @db.Uuid
  pipeline_id         String    @db.Uuid
  stage_id            String    @db.Uuid
  contact_id          String?   @db.Uuid
  lead_id             String?   @db.Uuid
  conversation_id     String?   @db.Uuid
  assigned_to         String?   @db.Uuid
  title               String
  value               Decimal   @default(0) @db.Decimal(12, 2)
  currency            String?   @default("USD")
  notes               String?
  expected_close_date DateTime? @db.Date
  status              String    @default("open")
  // Where this deal came from — mirrors Lead.source's documented-by-
  // convention style. Only WhatsApp Order auto-creation sets this today
  // ("whatsapp_order"); every other Deal is still created manually by an
  // agent, so this stays null for those.
  source              String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  account      Account       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stage_id], references: [id])
  contact      Contact?      @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@map("deals")
}

// ============================================================
// BROADCASTS
// ============================================================

model Broadcast {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @db.Uuid
  user_id            String    @db.Uuid
  name               String
  template_name      String
  template_language  String    @default("en_US")
  template_variables Json?
  // Overrides the template's approved sample media for this campaign's
  // IMAGE/VIDEO/DOCUMENT header. NULL = use the template's own header_media_url.
  header_media_url   String?
  // Which connected number to send from (Finding #14) — null falls back
  // to the account's default number, so pre-migration/single-number
  // broadcasts keep working unchanged.
  whatsapp_config_id String?   @db.Uuid
  audience_filter    Json?
  scheduled_at       DateTime? @db.Timestamptz(6)
  // Scheduling -- 'now' (default, unchanged behavior: sent immediately by
  // /process right after creation), 'once' (send at scheduled_at), or
  // 'recurring' (re-send to the FULL audience again every interval, up to
  // max_sends times or until cancelled -- there's no per-recipient
  // "stop_on_reply" concept here since a bulk fan-out has no single
  // conversation to watch, unlike ScheduledMessage). The sweep in
  // src/lib/broadcasts/sweep.ts drives 'once'/'recurring' rows; status
  // 'scheduled' means "waiting for next_send_at", set back to 'scheduled'
  // (with a new next_send_at) after each recurring cycle completes.
  schedule_type      String    @default("now")
  interval_value     Int?
  interval_unit      String? // 'minutes' | 'hours' | 'days'
  max_sends          Int       @default(1)
  sends_count        Int       @default(0)
  next_send_at       DateTime? @db.Timestamptz(6)
  last_sent_at       DateTime? @db.Timestamptz(6)
  status             String    @default("draft")
  total_recipients   Int       @default(0)
  sent_count         Int       @default(0)
  delivered_count    Int       @default(0)
  read_count         Int       @default(0)
  replied_count      Int       @default(0)
  failed_count       Int       @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account    Account             @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]
  messages   Message[]

  @@map("broadcasts")
}

model BroadcastRecipient {
  id                   String    @id @default(uuid()) @db.Uuid
  broadcast_id         String    @db.Uuid
  contact_id           String    @db.Uuid
  whatsapp_message_id  String?   @unique
  status               String    @default("pending")
  sent_at              DateTime? @db.Timestamptz(6)
  delivered_at         DateTime? @db.Timestamptz(6)
  read_at              DateTime? @db.Timestamptz(6)
  replied_at           DateTime? @db.Timestamptz(6)
  error_message        String?
  // The actual per-recipient body text after variable substitution —
  // computed once at send time (whether the send succeeded or failed) so
  // the report page can show exactly what this recipient's message said,
  // without re-deriving it later from data that may have since changed.
  rendered_body        String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  broadcast Broadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contact_id], references: [id])

  @@map("broadcast_recipients")
}

