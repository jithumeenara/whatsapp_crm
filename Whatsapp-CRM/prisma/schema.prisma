// ============================================================
// BROADCASTS
// ============================================================

model Broadcast {
  id                 String    @id @default(uuid()) @db.Uuid
  account_id         String    @db.Uuid
  user_id            String    @db.Uuid
  name               String
  template_name      String
  template_language  String    @default("en_US")
  template_variables Json?
  // Overrides the template's approved sample media for this campaign's
  // IMAGE/VIDEO/DOCUMENT header. NULL = use the template's own header_media_url.
  header_media_url   String?
  audience_filter    Json?
  scheduled_at       DateTime? @db.Timestamptz(6)
  // Scheduling -- 'now' (default, unchanged behavior: sent immediately by
  // /process right after creation), 'once' (send at scheduled_at), or
  // 'recurring' (re-send to the FULL audience again every interval, up to
  // max_sends times or until cancelled -- there's no per-recipient
  // "stop_on_reply" concept here since a bulk fan-out has no single
  // conversation to watch, unlike ScheduledMessage). The sweep in
  // src/lib/broadcasts/sweep.ts drives 'once'/'recurring' rows; status
  // 'scheduled' means "waiting for next_send_at", set back to 'scheduled'
  // (with a new next_send_at) after each recurring cycle completes.
  schedule_type      String    @default("now")
  interval_value     Int?
  interval_unit      String? // 'minutes' | 'hours' | 'days'
  max_sends          Int       @default(1)
  sends_count        Int       @default(0)
  next_send_at       DateTime? @db.Timestamptz(6)
  last_sent_at       DateTime? @db.Timestamptz(6)
  status             String    @default("draft")
  total_recipients   Int       @default(0)
  sent_count         Int       @default(0)
  delivered_count    Int       @default(0)
  read_count         Int       @default(0)
  replied_count      Int       @default(0)
  failed_count       Int       @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  account    Account             @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]
  messages   Message[]

  @@map("broadcasts")
}

model BroadcastRecipient {
  id                   String    @id @default(uuid()) @db.Uuid
  broadcast_id         String    @db.Uuid
  contact_id           String    @db.Uuid
  whatsapp_message_id  String?   @unique
  status               String    @default("pending")
  sent_at              DateTime? @db.Timestamptz(6)
  delivered_at         DateTime? @db.Timestamptz(6)
  read_at              DateTime? @db.Timestamptz(6)
  replied_at           DateTime? @db.Timestamptz(6)
  error_message        String?
  // The actual per-recipient body text after variable substitution —
  // computed once at send time (whether the send succeeded or failed) so
  // the report page can show exactly what this recipient's message said,
  // without re-deriving it later from data that may have since changed.
  rendered_body        String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  broadcast Broadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contact_id], references: [id])

  @@map("broadcast_recipients")
}

