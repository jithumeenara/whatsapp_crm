# ============================================================
# REQUIRED — the app won't start without these.
#
# Secrets below are deliberately left EMPTY. An empty value makes the
# app refuse to work (NextAuth throws MissingSecret, encryption throws,
# every Meta webhook is rejected) — that is the safe failure. A value
# copied from this template would instead be a secret the whole internet
# can read: anyone holding this file could forge a login session or a
# Meta webhook. Generate each one; never reuse one between servers.
# ============================================================

# On the server: NODE_ENV=production (set it in the PM2 ecosystem file,
# see docs/deploy/). server.ts runs Next in DEV mode whenever NODE_ENV is
# anything else — no Secure cookie, dev error overlays, on-demand compiles.

# PostgreSQL connection string. On a server use a dedicated, non-superuser
# role (see docs/deploy/HARDENING.md, "PostgreSQL") and a long random
# password; percent-encode @ : / in it (%40 %3A %2F).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://crm_app:CHANGE_ME@localhost:5432/whatsapp_crm

# NextAuth.js secret — generate with: openssl rand -base64 32
# Signs/encrypts every login session and keys the realtime, voice, form and
# sheet-link tickets. Set this one only: do NOT also set AUTH_SECRET —
# NextAuth prefers AUTH_SECRET, while src/proxy.ts reads NEXTAUTH_SECRET,
# so two different values lock everybody out.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes every stored channel token unreadable: keep a copy in a
# password manager, separate from the database backups.
ENCRYPTION_KEY=

# Meta App Secret (Meta for Developers → App Settings → Basic)
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
META_APP_SECRET=

# ============================================================
# RECOMMENDED
# ============================================================

# Canonical public URL of this deployment. Also the Socket.io CORS origin:
# unset, server.ts allows any origin ("*").
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Same URL. Used to build callback links (virus-scan callback, Flows
# endpoint, MCP, staff alerts). NEXT_PUBLIC_* values are compiled into the
# browser bundle — never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APP_URL=https://crm.example.com

# Show the public sign-up link and accept self sign-ups. Leave unset on a
# private deployment (members join by invitation).
# NEXT_PUBLIC_ALLOW_SIGNUP=true

# ============================================================
# OPTIONAL
# ============================================================

# Shared secret protecting GET /api/automations/cron
# Required if you use Wait steps in automations
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Shared secret protecting POST /api/voice/context
# Required if the WhatsApp voice agent should answer with the same prompt,
# knowledge base and caller record the chat assistant uses. The same value
# goes in the voice server's own .env as VOICE_AGENT_SECRET.
# VOICE_AGENT_SECRET=generate-a-long-random-string

# Meta App ID — required for template Resumable Upload
# META_APP_ID=your-meta-app-id

# Skip Meta API calls during local dev / CI for template testing
# WHATSAPP_TEMPLATES_DRY_RUN=true

# RSA-2048 private key for Meta WhatsApp Flows endpoint encryption.
# Required if you use WhatsApp Flows with data_exchange (dynamic data endpoint).
#
# How to generate:
#   openssl genrsa -out flows_private.pem 2048
#   openssl rsa -in flows_private.pem -pubout -out flows_public.pem
#
# 1. Upload flows_public.pem content to: Meta → Your Flow → Settings → Encryption Key
# 2. Set your endpoint URL in: Meta → Your Flow → Settings → Endpoint URI
#    Format: https://your-domain.com/api/flows/<flow-id>/webhook
# 3. Paste the private key below — replace all newlines with \n
#
# FLOWS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"

# Hostname allowlist for invite URLs (comma-separated)
# ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Server hostname and port
# HOSTNAME=localhost
# PORT=3000
# Interface Node listens on. Default 127.0.0.1 in production, so only the
# local nginx can reach it. Do not set 0.0.0.0 on a VPS: a direct
# connection to Node can forge X-Real-IP and defeat every rate limit.
# BIND_HOST=127.0.0.1

# Instagram / Facebook Messenger webhooks (only if you use those channels)
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=generate-a-long-random-string
# FACEBOOK_VERIFY_TOKEN=generate-a-long-random-string
# Never leave this set on a live server: "observe" lets Instagram/Facebook
# webhooks through WITHOUT a valid signature. Only for a short diagnosis.
# META_SOCIAL_SIGNATURE=observe
# Same for the WhatsApp Flows endpoint (/api/flows/.../webhook and
# /api/flows/data-exchange/...): "observe" accepts requests whose
# X-Hub-Signature-256 does not match META_APP_SECRET / the Quick Connect secret.
# META_FLOWS_SIGNATURE=observe

# Web push (Settings → Notifications). Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Platform-level Razorpay keys (fallback when no per-account integration)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional virus-scan hook: POSTed the file URL and a signed callback URL.
# VIRUS_SCAN_WEBHOOK_URL=http://127.0.0.1:8080/scan

# AI cost reporting exchange rate (number between 1 and 1000)
# USD_INR_RATE=84

# Build tuning for a small (2 GB) VPS — see next.config.ts
# NEXT_BUILD_CPUS=1
# NEXT_SKIP_TYPECHECK=1

# ── Google Cloud Text-to-Speech (optional, strongly recommended) ─
# Upgrades the voice used for WhatsApp voice-note replies. Without it
# the assistant falls back to the built-in Gemini voice and still works.
#
# With it, per measurement against the live API:
#   - about 1 second per reply instead of about 8
#   - native Malayalam/Tamil/Hindi voices instead of an English-trained
#     voice reading Malayalam
#   - OGG/Opus output, which WhatsApp shows as a real voice note with a
#     waveform rather than as an attached audio file
#
# Setup: Google Cloud Console -> enable the Text-to-Speech API -> create
# a service account with the "Cloud Text-to-Speech User" role -> create a
# JSON key. Paste the whole JSON on one line below.
#
# This key grants access to a Cloud project, so it is deliberately an
# environment variable and never a per-account database value. Do not
# commit it, and rotate it if it is ever pasted anywhere it shouldn't be.
GOOGLE_TTS_CREDENTIALS=

# Same JSON, base64-encoded. Use this instead on any host that mangles
# the newlines inside the private key when storing a multi-line value.
# GOOGLE_TTS_CREDENTIALS_B64=
# Or a path to the JSON key file (chmod 600, owned by the app user):
# GOOGLE_APPLICATION_CREDENTIALS=/home/crm/secrets/tts.json

# Development machines only — never on a server. Blocks every message
# to real people and the background jobs (src/lib/dev/send-guard.ts),
# and shows a red DEV bar.
# APP_ENV=development
# DEV_ALLOWED_RECIPIENTS=9198XXXXXXXX
# DEV_RUN_JOBS=1
# DEV_ALLOW_SENDING=1

# Who may download a backup of the whole database (Settings → Database).
# Unset: the owner of the first workspace on this server.
# PLATFORM_ADMIN_EMAILS=owner@example.com
