node-options=--max-old-space-size=4096
# Every package comes from the public npm registry, named explicitly so a
# user- or machine-level .npmrc can't silently swap in another source.
registry=https://registry.npmjs.org/
# `npm install <pkg>` records the exact version, not a ^range, so a new
# release only arrives through a reviewed lockfile/package.json change.
save-exact=true
